/*
 * Replace tester_xiao's baseline direct kscan with a zmk,kscan-composite
 * wrapping a direct child (row 0, 3 keys) and a matrix child (rows 1-2, 2x4
 * cells, 8 of which are mapped), so kscan diagnostics' topology code can be
 * exercised against composite child resolution (leaf_index + row/col
 * offsets) in a real build.
 *
 * tester_xiao's shared transform0 is sized to match its keymap (11
 * bindings, see tester_xiao.keymap), so the composite's total mapped cells
 * must be 11: 3 (direct) + 8 (matrix) = 11. Pin budget: 3 + (2 + 4) = 9,
 * within tester_xiao's xiao_d 0..10 budget.
 */
&kscan0 {
	status = "disabled";
};

/ {
	chosen {
		zmk,kscan = &composite_kscan;
	};

	direct_child: direct_child {
		compatible = "zmk,kscan-gpio-direct";
		wakeup-source;
		debounce-press-ms = <5>;
		debounce-release-ms = <5>;
		input-gpios
			= <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&xiao_d 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			, <&xiao_d 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
			;
	};

	matrix_child: matrix_child {
		compatible = "zmk,kscan-gpio-matrix";
		wakeup-source;
		diode-direction = "col2row";
		debounce-press-ms = <5>;
		debounce-release-ms = <5>;
		row-gpios
			= <&xiao_d 3 (GPIO_ACTIVE_HIGH)>
			, <&xiao_d 4 (GPIO_ACTIVE_HIGH)>
			;
		col-gpios
			= <&xiao_d 5 (GPIO_ACTIVE_HIGH)>
			, <&xiao_d 6 (GPIO_ACTIVE_HIGH)>
			, <&xiao_d 7 (GPIO_ACTIVE_HIGH)>
			, <&xiao_d 8 (GPIO_ACTIVE_HIGH)>
			;
	};

	composite_kscan: composite_kscan {
		compatible = "zmk,kscan-composite";
		rows = <3>;
		columns = <4>;

		direct_part {
			kscan = <&direct_child>;
			row-offset = <0>;
			col-offset = <0>;
		};

		matrix_part {
			kscan = <&matrix_child>;
			row-offset = <1>;
			col-offset = <0>;
		};
	};
};

&physical_layout0 {
	kscan = <&composite_kscan>;
};

/*
 * RC(row, col) here must be the matrix-transform variant, but the keymap's
 * own includes (dt-bindings/zmk/keys.h -> modifiers.h) redefine RC(keycode)
 * as a single-argument modifier helper. Force the matrix-transform
 * definition back for this file (zmk-module-dev SKILL.md pitfall).
 */
#undef RC
#include <dt-bindings/zmk/matrix_transform.h>

&transform0 {
	rows = <3>;
	columns = <4>;
	map = <
	RC(0,0)  RC(0,1)  RC(0,2)
	RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)
	RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)
	>;
};
