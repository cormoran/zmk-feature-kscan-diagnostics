/*
 * Replace tester_xiao's baseline direct kscan with a GPIO matrix so kscan
 * diagnostics' topology code can be exercised against
 * zmk,kscan-gpio-matrix in a real build.
 *
 * tester_xiao's shared transform0 is sized to match its keymap (11
 * bindings, see tester_xiao.keymap), so this matrix must expose at least 11
 * distinct (row, col) cells; a 2 row x 6 col matrix (8 pins, well within
 * tester_xiao's xiao_d 0..10 budget) gives 12 cells, of which 11 are mapped.
 */
&kscan0 {
	compatible = "zmk,kscan-gpio-matrix";
	/delete-property/ input-gpios;
	wakeup-source;
	diode-direction = "col2row";
	debounce-press-ms = <5>;
	debounce-release-ms = <5>;
	row-gpios
		= <&xiao_d 0 (GPIO_ACTIVE_HIGH)>
		, <&xiao_d 1 (GPIO_ACTIVE_HIGH)>
		;
	col-gpios
		= <&xiao_d 2 (GPIO_ACTIVE_HIGH)>
		, <&xiao_d 3 (GPIO_ACTIVE_HIGH)>
		, <&xiao_d 4 (GPIO_ACTIVE_HIGH)>
		, <&xiao_d 5 (GPIO_ACTIVE_HIGH)>
		, <&xiao_d 6 (GPIO_ACTIVE_HIGH)>
		, <&xiao_d 7 (GPIO_ACTIVE_HIGH)>
		;
};

/*
 * RC(row, col) here must be the matrix-transform variant, but the keymap's
 * own includes (dt-bindings/zmk/keys.h -> modifiers.h) redefine RC(keycode)
 * as a single-argument modifier helper. Force the matrix-transform
 * definition back for this file (zmk-module-dev SKILL.md pitfall).
 */
#undef RC
#include <dt-bindings/zmk/matrix_transform.h>

&transform0 {
	rows = <2>;
	columns = <6>;
	map = <
	RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)
	RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)
	>;
};
