/*
 * Compile both of the two remaining official kscan compats not covered by
 * the other diag-* snippets: zmk,kscan-gpio-charlieplex and
 * zmk,kscan-gpio-demux. Both instances build and link; the physical layout
 * selects the charlieplex device as the active kscan (kscan diagnostics'
 * topology.c must still enumerate the demux device as a leaf device even
 * though no layout currently points at it).
 *
 * tester_xiao's shared transform0 is sized to match its keymap (11
 * bindings, see tester_xiao.keymap): a 4-pin charlieplex gives 4x4-4=12
 * usable (row != col) cells, of which 11 are mapped. Pin budget:
 * charlieplex 4 + demux (2 input + 2 output) = 8, within tester_xiao's
 * xiao_d 0..10 budget.
 */
&kscan0 {
	status = "disabled";
};

/ {
	chosen {
		zmk,kscan = &charlieplex_kscan;
	};

	charlieplex_kscan: charlieplex_kscan {
		compatible = "zmk,kscan-gpio-charlieplex";
		wakeup-source;
		debounce-press-ms = <5>;
		debounce-release-ms = <5>;
		gpios
			= <&xiao_d 0 (GPIO_ACTIVE_HIGH)>
			, <&xiao_d 1 (GPIO_ACTIVE_HIGH)>
			, <&xiao_d 2 (GPIO_ACTIVE_HIGH)>
			, <&xiao_d 3 (GPIO_ACTIVE_HIGH)>
			;
	};

	demux_kscan: demux_kscan {
		compatible = "zmk,kscan-gpio-demux";
		input-gpios
			= <&xiao_d 4 (GPIO_ACTIVE_HIGH)>
			, <&xiao_d 5 (GPIO_ACTIVE_HIGH)>
			;
		output-gpios
			= <&xiao_d 6 (GPIO_ACTIVE_HIGH)>
			, <&xiao_d 7 (GPIO_ACTIVE_HIGH)>
			;
	};
};

&physical_layout0 {
	kscan = <&charlieplex_kscan>;
};

/*
 * RC(row, col) here must be the matrix-transform variant, but the keymap's
 * own includes (dt-bindings/zmk/keys.h -> modifiers.h) redefine RC(keycode)
 * as a single-argument modifier helper. Force the matrix-transform
 * definition back for this file (zmk-module-dev SKILL.md pitfall).
 */
#undef RC
#include <dt-bindings/zmk/matrix_transform.h>

&transform0 {
	rows = <4>;
	columns = <4>;
	map = <
	          RC(0,1)  RC(0,2)  RC(0,3)
	RC(1,0)            RC(1,2)  RC(1,3)
	RC(2,0)  RC(2,1)             RC(2,3)
	RC(3,0)  RC(3,1)  RC(3,2)
	>;
};
